# Copy to .env and adjust as needed.
CYBOT_API_KEY=
CYBOT_OLLAMA_BASE_URL=http://localhost:11434
CYBOT_OLLAMA_MODEL=llama3.1:8b
CYBOT_EMBEDDING_BACKEND=default
CYBOT_RETRIEVAL_K=4

# Threat intelligence (each remote provider is enabled only when its key is set)
CYBOT_INTEL_ENABLED=true
CYBOT_ABUSEIPDB_API_KEY=
CYBOT_VIRUSTOTAL_API_KEY=
CYBOT_GREYNOISE_API_KEY=
CYBOT_URLHAUS_API_KEY=
CYBOT_INTEL_MAX_LOOKUPS=8
CYBOT_INTEL_CACHE_TTL_HOURS=24

# Automated response (dry_run simulates every action; live sends approved actions to the webhook)
CYBOT_RESPONSE_ENABLED=true
CYBOT_RESPONSE_MODE=dry_run
CYBOT_RESPONSE_WEBHOOK_URL=
CYBOT_RESPONSE_WEBHOOK_SECRET=
